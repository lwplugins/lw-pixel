#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:67 build/index.js:1
msgid "Give the event a name."
msgstr "Adj nevet az eseménynek."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:73 build/index.js:1
msgid "A click trigger needs a CSS selector."
msgstr "A kattintás kiváltóhoz CSS-szelektor kell."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:116 build/index.js:1
msgid ""
"Start with a letter, then use letters, digits or underscores (max. 40), e.g. "
"MyCustomEvent."
msgstr ""
"Betűvel kezdődjön, utána betűk, számjegyek vagy aláhúzás jöhetnek (max. 40), "
"pl. MyCustomEvent."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:117
#: includes/Rest/Admin/Settings/ValueParser.php:48
msgid "Choose one of the listed options."
msgstr "Válassz a felsorolt lehetőségek közül."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:118 build/index.js:1
msgid "This is not a usable CSS selector."
msgstr "Ez nem használható CSS-szelektor."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:121 build/index.js:1
msgid ""
"Start with / (a path such as /products/*) or leave it empty for every page."
msgstr ""
"Kezdd /-rel (egy útvonal, pl. /termekek/*), vagy hagyd üresen, ha minden "
"oldalon kell."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:122 build/index.js:1
msgid "Use a number such as 10 or 9.99, or leave it empty."
msgstr "Adj meg egy számot, pl. 10 vagy 9.99, vagy hagyd üresen."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:123 build/index.js:1
msgid "Use a three-letter currency code such as HUF, EUR or USD."
msgstr "Háromjegyű pénznemkódot adj meg, pl. HUF, EUR vagy USD."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:124
msgid "Unknown field."
msgstr "Ismeretlen mező."

#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:147
#: includes/Rest/Admin/Settings/SettingsInput.php:120
#: includes/Rest/Admin/Settings/ValueParser.php:89
#: includes/Rest/Admin/Settings/ValueParser.php:212
#: includes/Rest/Admin/Settings/ValueParser.php:267
#: includes/Rest/Admin/Settings/ValueParser.php:287
msgid "Must be text."
msgstr "Szövegnek kell lennie."

#. translators: %d: maximum number of characters.
#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:154
#: includes/Rest/Admin/Settings/ValueParser.php:294
#, php-format
msgid "Use at most %d characters."
msgstr "Legfeljebb %d karakter lehet."

#. translators: 1: smallest allowed number, 2: largest allowed number.
#: includes/Rest/Admin/CustomEvents/CustomEventInput.php:179
#, php-format
msgid "Use a whole number from %1$d to %2$d."
msgstr "Egész számot adj meg %1$d és %2$d között."

#: includes/Rest/Admin/CustomEvents/CustomEventsController.php:123
msgid "The event could not be deleted."
msgstr "Az eseményt nem sikerült törölni."

#: includes/Rest/Admin/CustomEvents/CustomEventsController.php:153
msgid "Some fields are not valid. Nothing was saved."
msgstr "Néhány mező érvénytelen. Semmi sem lett elmentve."

#: includes/Rest/Admin/CustomEvents/CustomEventsController.php:162
msgid "The event could not be saved."
msgstr "Az eseményt nem sikerült elmenteni."

#: includes/Rest/Admin/CustomEvents/CustomEventsController.php:176
msgid "This custom event does not exist."
msgstr "Ez az egyéni esemény nem létezik."

#: includes/Rest/Admin/MigratorController.php:62
msgid "This import source is not available."
msgstr "Ez az importálási forrás nem érhető el."

#: includes/Rest/Admin/Routes.php:106
msgid "The request is too large."
msgstr "A kérés túl nagy."

#: includes/Rest/Admin/Settings/SettingsInput.php:53
msgid "Unknown setting."
msgstr "Ismeretlen beállítás."

#: includes/Rest/Admin/Settings/SettingsInput.php:57
msgid "Only users who may post unfiltered HTML can change custom code."
msgstr ""
"Egyéni kódot csak szűretlen HTML közzétételére jogosult felhasználó "
"módosíthat."

#. translators: %s: PHP constant name.
#: includes/Rest/Admin/Settings/SettingsInput.php:115
#, php-format
msgid "This key is set in wp-config.php (%s), so it cannot be changed here."
msgstr ""
"Ez a kulcs a wp-config.php-ban van megadva (%s), ezért itt nem módosítható."

#: includes/Rest/Admin/Settings/SettingsInput.php:127
msgid "Paste the key exactly as shown, without spaces."
msgstr "Pontosan úgy illeszd be a kulcsot, ahogy látod, szóközök nélkül."

#. translators: %s: pixel ID.
#: includes/Rest/Admin/Settings/SettingsInput.php:166
#, php-format
msgid "Pixel \"%s\" is in more than one consent category."
msgstr "A(z) „%s” pixel több hozzájárulási kategóriában is szerepel."

#: includes/Rest/Admin/Settings/ValueParser.php:77
msgid "Must be true or false."
msgstr "Igaz vagy hamis értéknek kell lennie."

#: includes/Rest/Admin/Settings/ValueParser.php:104
msgid ""
"This ID does not have the expected format. Copy it again from the ad "
"platform."
msgstr ""
"Ennek az azonosítónak nem megfelelő a formátuma. Másold ki újra a hirdetési "
"felületről."

#: includes/Rest/Admin/Settings/ValueParser.php:119
#: includes/Rest/Admin/Settings/ValueParser.php:152
msgid "Must be a comma-separated list."
msgstr "Vesszővel elválasztott listának kell lennie."

#. translators: 1: smallest allowed number, 2: largest allowed number.
#: includes/Rest/Admin/Settings/ValueParser.php:129
#, php-format
msgid "Use whole numbers from %1$d to %2$d, separated by commas."
msgstr "%1$d és %2$d közötti egész számokat adj meg, vesszővel elválasztva."

#: includes/Rest/Admin/Settings/ValueParser.php:161
msgid ""
"Use file extensions such as pdf or zip (letters and digits only), separated "
"by commas."
msgstr ""
"Fájlkiterjesztéseket adj meg, pl. pdf vagy zip (csak betűk és számjegyek), "
"vesszővel elválasztva."

#. translators: %d: maximum number of lines.
#: includes/Rest/Admin/Settings/ValueParser.php:220
#, php-format
msgid "Use at most %d lines."
msgstr "Legfeljebb %d sor lehet."

#. translators: %d: maximum number of characters.
#: includes/Rest/Admin/Settings/ValueParser.php:226
#, php-format
msgid "Each line can be at most %d characters long."
msgstr "Egy sor legfeljebb %d karakter hosszú lehet."

#: includes/Rest/Admin/Settings/ValueParser.php:242
msgid "Must be a list of pixel IDs."
msgstr "Pixelazonosítók listájának kell lennie."

#. translators: %s: pixel ID.
#: includes/Rest/Admin/Settings/ValueParser.php:250
#, php-format
msgid "Unknown pixel: \"%s\"."
msgstr "Ismeretlen pixel: „%s”."

#. translators: %d: maximum size in kilobytes.
#: includes/Rest/Admin/Settings/ValueParser.php:272
#, php-format
msgid "The code can be at most %d KB."
msgstr "A kód legfeljebb %d KB lehet."

#: includes/Rest/Admin/SettingsController.php:85
msgid "Some settings are not valid. Nothing was saved."
msgstr "Néhány beállítás érvénytelen. Semmi sem lett elmentve."

#: includes/Server/ChatGptCAPI.php:125
msgid "Save a ChatGPT Ads pixel ID and Conversions API key first."
msgstr ""
"Előbb ments el egy ChatGPT Ads pixelazonosítót és egy Conversions API-"
"kulcsot."

#: includes/Server/ChatGptCAPI.php:156
msgid ""
"Connected. ChatGPT Ads accepted a test event (validation only, nothing was "
"recorded)."
msgstr ""
"Kapcsolódva. A ChatGPT Ads elfogadott egy teszteseményt (csak ellenőrzés, "
"semmi sem lett rögzítve)."

#: includes/Server/ChatGptCAPI.php:160
msgid ""
"ChatGPT Ads rejected the API key. Check the key and that it belongs to this "
"pixel."
msgstr ""
"A ChatGPT Ads elutasította az API-kulcsot. Ellenőrizd a kulcsot, és hogy "
"ehhez a pixelhez tartozik-e."

#: includes/Server/ChatGptCAPI.php:164
msgid "Could not reach the ChatGPT Ads API from this server."
msgstr "Erről a szerverről nem érhető el a ChatGPT Ads API."

#. translators: %d: HTTP status code.
#: includes/Server/ChatGptCAPI.php:169
#, php-format
msgid "ChatGPT Ads returned HTTP %d. Check the pixel ID and API key."
msgstr ""
"A ChatGPT Ads HTTP %d választ adott. Ellenőrizd a pixelazonosítót és az API-"
"kulcsot."

